# AssemblyAI Speech-to-Text, Voice Agent, and LLM Gateway API key.
ASSEMBLYAI_API_KEY=
# Agent backend selection: auto, voice_agent, or llm.
AGENT_BACKEND=auto
# Groq API key used by the LLM backend when available.
GROQ_API_KEY=
# Optional Gemini API key used as an LLM fallback.
GEMINI_API_KEY=
# Display name for the protected older adult.
SENIOR_NAME=Margaret
# Display name for the family contact.
FAMILY_NAME=Sarah
# HTTP port for the FastAPI server.
PORT=8000
# Demo-only Guardian failure switch; 1 exercises the local fallback controls.
SIMULATE_AGENT_FAIL=0
